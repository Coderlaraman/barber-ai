{
  "name": "barberia-scheduler-service",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpileOnly src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint --max-warnings=0 'src/**/*.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migration:generate": "npm run build --silent && typeorm -d dist/infrastructure/typeorm/data-source.js migration:generate src/infrastructure/typeorm/migrations/init",
    "migration:run": "npm run build --silent && typeorm -d dist/infrastructure/typeorm/data-source.js migration:run",
    "seed:dev": "npm run build --silent && node dist/infrastructure/typeorm/seed.js"
  },
  "dependencies": {
    "barberia-contracts": "file:../../packages/contracts",
    "@nestjs/common": "^10.4.10",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.4.10",
    "@nestjs/platform-express": "^10.4.10",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}