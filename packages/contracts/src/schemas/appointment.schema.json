{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Appointment",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "barberId": { "type": "string" },
    "clientId": { "type": "string" },
    "serviceId": { "type": "string" },
    "start": { "type": "string", "format": "date-time" },
    "end": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["REQUESTED", "CONFIRMED", "CANCELLED", "COMPLETED"] }
  },
  "required": ["id", "barberId", "clientId", "serviceId", "start", "end", "status"]
}