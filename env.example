# ==========================================
# BARBER AI - VARIABLES DE ENTORNO
# ==========================================

# === CONFIGURACIÓN DE LA APLICACIÓN ===
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# === BASE DE DATOS ===
# Configuración de PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tu_usuario_postgres
DB_PASSWORD=tu_contraseña_postgres
DB_DATABASE=barber_ai_db

# === JWT (JSON Web Tokens) ===
# Clave secreta para firmar tokens (debe ser muy segura en producción)
JWT_SECRET=tu_jwt_secret_muy_seguro_aqui
# Tiempo de expiración del access token (en segundos)
JWT_EXPIRES_IN=900s
# Tiempo de expiración del refresh token (en segundos)
JWT_REFRESH_EXPIRES_IN=7d

# === AUTENTICACIÓN CON GOOGLE ===
# Credenciales de OAuth2 de Google
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui

# === AUTENTICACIÓN CON FACEBOOK ===
# Credenciales de la aplicación de Facebook
FACEBOOK_APP_ID=tu_facebook_app_id_aqui
FACEBOOK_APP_SECRET=tu_facebook_app_secret_aqui

# === REDIS (Para caché y sesiones) ===
# Configuración de Redis (opcional pero recomendado)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=tu_contraseña_redis_opcional

# === EMAIL/SMTP (Para verificación de correo y notificaciones) ===
# Configuración del servicio de correo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion_aqui

# === ALMACENAMIENTO DE ARCHIVOS ===
# Configuración para subida de imágenes (perfiles, servicios, etc.)
AWS_ACCESS_KEY_ID=tu_aws_access_key_id
AWS_SECRET_ACCESS_KEY=tu_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=barber-ai-bucket

# === MONITOREO Y LOGS ===
# URL para envío de logs (opcional)
LOG_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
# Nivel de logging: debug, info, warn, error
LOG_LEVEL=info

# === SEGURIDAD ===
# Número máximo de intentos de login fallidos antes de bloquear cuenta
MAX_FAILED_LOGIN_ATTEMPTS=5
# Tiempo de bloqueo de cuenta en minutos
ACCOUNT_LOCK_TIME_MINUTES=30
# Límite de requests por IP (rate limiting)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# === PAGOS (Stripe/PayPal) ===
# Configuración de pasarela de pagos (cuando implementemos citas con pago)
STRIPE_SECRET_KEY=sk_test_tu_stripe_secret_key_aqui
STRIPE_WEBHOOK_SECRET=whsec_tu_stripe_webhook_secret
PAYPAL_CLIENT_ID=tu_paypal_client_id
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret

# === NOTIFICACIONES PUSH ===
# Para notificaciones móviles (cuando desarrollemos app móvil)
FIREBASE_PROJECT_ID=tu_firebase_project_id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\ntu_firebase_private_key_aqui\n-----END PRIVATE KEY-----\n
# === API EXTERNAS ===
# Google Maps API para geolocalización
GOOGLE_MAPS_API_KEY=tu_google_maps_api_key

# === DESARROLLO ===
# Habilitar modo debug (solo en desarrollo)
DEBUG=true
# Habilitar documentación Swagger (desactivar en producción)
SWAGGER_ENABLED=true